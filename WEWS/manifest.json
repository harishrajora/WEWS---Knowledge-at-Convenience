{
  "name": "WEWS",
  "manifest_version": 3,
  "version": "4.5",
  "description": "Weather and News at one place. Update yourself by just opening a new tab and no extra efforts",
  "icons": { "128": "icon.png" },

  "permissions": ["geolocation", "bookmarks"],
  "host_permissions": [
    "https://api.openweathermap.org/*",
    "https://api.nytimes.com/*",
    "https://newsapi.org/*"
  ],

  "action": {
    "default_title": "WEWS - Update Yourself",
    "default_icon": "icon.png",
    "default_popup": "empty_popup.html"
  },

  "chrome_url_overrides": {
    "newtab": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "short_name": "WEWS",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
